wfx_target=x86_64-pc-windows-msvc
wfx_lto_mode=thin
wfx_optimize="-O2 -w"
export WFX_RELEASE=1
. "$topsrcdir/konafox/build/mozconfig.common"

ac_add_options --enable-application=browser
ac_add_options --enable-updater
ac_add_options --disable-unverified-updates
ac_add_options --enable-update-channel=konafox-release
ac_add_options MAR_CHANNEL_ID=konafox-release
ac_add_options ACCEPTED_MAR_CHANNEL_IDS=konafox-release
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-konafox-release
